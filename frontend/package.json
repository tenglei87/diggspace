{
  "name": "diggspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:remote": "wrangler dev --remote --var CACHE_TTL:0",
    "db:migrate": "wrangler d1 migrations apply diggspace --local",
    "dev:seed": "wrangler d1 execute diggspace --local --file=./scripts/seed-dev.sql",
    "crawl": "curl -sSN -X POST -H \"Authorization: Bearer local-dev-token\" \"http://localhost:8787/api/admin/crawl?all=1&favicons=all\"",
    "deploy": "node scripts/check-deployment.mjs && wrangler d1 migrations apply diggspace --remote && wrangler deploy",
    "check:deploy": "node scripts/check-deployment.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.156.0"
  },
  "dependencies": {
    "hono": "^4.13.16"
  }
}
